# Optional local configuration; copy to .env and export values in your shell.
SOC_DATA_DIR=data
SOC_DATABASE_PATH=data/soc.db
SOC_LLM_PROVIDER=ollama
SOC_LLM_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
# Phase 6 model calls are loopback-only unless explicitly opted in.
ALLOW_REMOTE_LLM=false
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_STALE_TIMEOUT_SECONDS=900
LLM_MAX_ATTEMPTS=3
LLM_PACKET_MAX_BYTES=256000
LLM_PACKET_MAX_EVENTS=100
LLM_PACKET_MAX_IOCS=100
LLM_PACKET_MAX_MAPPINGS=100
LLM_RAW_EXCERPT_CHARS=1000
LLM_MAX_VALIDATION_ERRORS=10
LLM_CREATED_BY=system
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_ENABLED=false
# Set a strong secret only when API_AUTH_ENABLED=true.
API_AUTH_TOKEN=
API_CORS_ORIGINS=http://localhost:3000
SOC_LOG_LEVEL=INFO
SOC_MAX_PARSE_ERRORS=100
SOC_SCANNER_ENABLED=true
SOC_SCANNER_LAB_MODE=true
SOC_SCANNER_ALLOWED_TARGETS=127.0.0.1,localhost,::1
INGEST_ASSUME_TZ=UTC
# Optional year for RFC3164 syslog/auth.log timestamps, such as 2026
# INGEST_ASSUME_YEAR=2026
INGEST_MAX_FILE_BYTES=104857600
INGEST_MAX_LINE_LENGTH=65536
INGEST_MAX_RAW_BYTES=16384
INGEST_DETECTION_LINES=20
INGEST_MAX_PARSE_ERRORS=100
INGEST_INVALID_THRESHOLD_PERCENT=50
INGEST_CHUNK_SIZE=1000
# Phase 9A is simulation-only; there is intentionally no execution-mode setting.
SOC_RESPONSE_APPROVAL_TTL_SECONDS=3600
SOC_RESPONSE_REQUIRE_DIFFERENT_APPROVER=false
SOC_RESPONSE_PROTECTED_IPS=
SOC_RESPONSE_PROTECTED_HOSTS=
SOC_RESPONSE_PROTECTED_ACCOUNTS=administrator,system,root
